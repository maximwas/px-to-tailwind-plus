{
  "name": "px-to-tailwind-plus",
  "displayName": "Px to Tailwind Plus",
  "description": "Convert pixel values to Tailwind CSS classes as you type — Tailwind v4 dynamic spacing & v3 classic scale, for VS Code and Cursor.",
  "version": "1.0.3",
  "publisher": "maksym-vasianin",
  "license": "MIT",
  "homepage": "https://github.com/maximwas/px-to-tailwind-plus#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/maximwas/px-to-tailwind-plus.git"
  },
  "bugs": {
    "url": "https://github.com/maximwas/px-to-tailwind-plus/issues"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "keytar",
      "@vscode/vsce-sign"
    ]
  },
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "tailwind",
    "px",
    "converter",
    "cursor",
    "tailwindcss"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:astro"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pxToTwPlus.convertFile",
        "title": "Convert File",
        "category": "Px to Tailwind Plus"
      },
      {
        "command": "pxToTwPlus.convertSelection",
        "title": "Convert Selection",
        "category": "Px to Tailwind Plus"
      },
      {
        "command": "pxToTwPlus.toggle",
        "title": "Toggle Extension",
        "category": "Px to Tailwind Plus"
      },
      {
        "command": "pxToTwPlus.showLogs",
        "title": "Show Logs",
        "category": "Px to Tailwind Plus"
      }
    ],
    "configuration": {
      "title": "Px to Tailwind Plus",
      "properties": {
        "pxToTwPlus.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable px → Tailwind conversion.",
          "scope": "window"
        },
        "pxToTwPlus.mode": {
          "type": "string",
          "enum": [
            "v4",
            "v3"
          ],
          "enumDescriptions": [
            "Tailwind v4 — dynamic spacing with quarter-step bare classes (e.g. p-4.5).",
            "Tailwind v3 — fixed classic spacing scale; off-scale values become arbitrary."
          ],
          "default": "v4",
          "description": "Which Tailwind version's spacing model to target.",
          "scope": "resource"
        },
        "pxToTwPlus.spacingBasePx": {
          "type": "number",
          "default": 4,
          "minimum": 0.25,
          "description": "Base spacing unit in pixels (Tailwind's --spacing). value = px / spacingBasePx.",
          "scope": "resource"
        },
        "pxToTwPlus.stepGranularity": {
          "type": "number",
          "enum": [
            1,
            0.5,
            0.25
          ],
          "enumDescriptions": [
            "Integers only — everything else becomes an arbitrary value.",
            "Half steps allowed (e.g. p-4.5).",
            "Quarter steps allowed (e.g. p-3.25)."
          ],
          "default": 0.25,
          "description": "Smallest bare-class step allowed in v4 mode. Values outside this granularity become arbitrary.",
          "scope": "resource"
        },
        "pxToTwPlus.arbitraryFor": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "spacing",
              "direct",
              "fontSize",
              "radius"
            ],
            "enumDescriptions": [
              "Padding, margin, width/height, gap, inset, translate, …",
              "Border/ring/outline/stroke widths.",
              "font-size (text-*).",
              "border-radius (rounded-*)."
            ]
          },
          "default": [],
          "markdownDescription": "Categories that should always use an arbitrary `[Npx]` value instead of a named/scale token. For example, add `fontSize` to keep `text-[14px]` instead of `text-sm`, or `radius` to keep `rounded-[8px]`.",
          "scope": "resource"
        },
        "pxToTwPlus.supportedLanguages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "html",
              "javascript",
              "javascriptreact",
              "typescript",
              "typescriptreact",
              "vue",
              "svelte",
              "astro"
            ]
          },
          "default": [
            "html",
            "javascript",
            "javascriptreact",
            "typescript",
            "typescriptreact",
            "vue",
            "svelte",
            "astro"
          ],
          "description": "Languages where conversion is active.",
          "scope": "window"
        },
        "pxToTwPlus.classFunctions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "clsx",
            "cn",
            "cx",
            "cva",
            "classnames",
            "classNames",
            "tw",
            "twMerge",
            "twJoin"
          ],
          "markdownDescription": "Names of class-utility functions whose string arguments are treated as class context (e.g. `clsx(\"p-16px\")`). Add your own helpers here.",
          "scope": "resource"
        },
        "pxToTwPlus.convertWhileTyping": {
          "type": "boolean",
          "default": true,
          "description": "Convert px classes live as you type (on completing `px` or a boundary character). Turn off to only convert via the quick fix or on save.",
          "scope": "resource"
        },
        "pxToTwPlus.convertOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Also convert every px class in the file when it is saved.",
          "scope": "resource"
        },
        "pxToTwPlus.showDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Highlight px classes that can be converted with a warning and a quick fix.",
          "scope": "resource"
        },
        "pxToTwPlus.showVisualFeedback": {
          "type": "boolean",
          "default": true,
          "description": "Briefly highlight converted ranges.",
          "scope": "window"
        },
        "pxToTwPlus.showHoverTooltips": {
          "type": "boolean",
          "default": true,
          "description": "Show pixel/rem values when hovering Tailwind spacing classes.",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc --noEmit && node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node scripts/generate-icon.mjs",
    "package": "vsce package --no-dependencies",
    "publish:ms": "vsce publish --no-dependencies",
    "publish:openvsx": "ovsx publish --no-dependencies",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "postcss": "^8.5.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@types/vscode": "^1.84.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.18.0",
    "ovsx": "^0.10.1",
    "sharp": "^0.33.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
